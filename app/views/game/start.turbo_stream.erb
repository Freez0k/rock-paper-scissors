<%= turbo_stream.replace "modal-result" do %>
  <div id="modal-result">
    <%= render "game/result", message: @message, subtitle: @result_subtitle %>
  </div>
<% end %>

<%= turbo_stream.update "modal-status" do %>
  <%= @result_title %>
<% end %>

<%= turbo_stream.update "modal-loader" do %>
  
<% end %>

<%= turbo_stream.update "modal-waiting" do %>
  
<% end %>

<%= turbo_stream.replace "modal-ok-wrapper" do %>
  <div id="modal-ok-wrapper" class="modal-ok-wrapper">
    <button id="modal-ok" class="modal-ok">OK</button>
  </div>
<% end %>

